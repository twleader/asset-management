+    private static TradingRadarRuleEngine.StockResult apply(TradingRadarRuleEngine.StockResult baseline,
+            List<StockPriceHistory> daily, List<StockPriceHistory> weekly,
+            boolean held, boolean regularSafe, boolean trialSafe) {
+        return RadarTurningPointPolicy.apply(baseline, prepared(daily, weekly, 0), held, regularSafe, trialSafe);
+    }
+    static RadarInputAssembler.Prepared prepared(List<StockPriceHistory> daily, List<StockPriceHistory> weekly, int start) {
+        var bars = weekly.stream().map(row -> new WeeklyBarAggregator.WeeklyBar(row.getTradingDate(),
+                row.getClosePrice(), row.getHighPrice(), row.getLowPrice(), row.getClosePrice(), row.getVolume())).toList();
+        return new RadarInputAssembler.Prepared(daily, daily, false, false, List.of(), null,
+                start, daily.size(), null, bars, List.of());
+    }
+    private static List<StockPriceHistory> recovery(int count, int step) {
+        return rows(count, step, "86", "85", "84", "83", "82", "81", "80", "80", "80", "80");
