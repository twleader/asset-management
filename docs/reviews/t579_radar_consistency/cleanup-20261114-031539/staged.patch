+    private static List<StockPriceHistory> highTurn(int count, int step) {
+        return rows(count, step, "95", "97", "115", "116", "114", "110", "108", "106", "104", "102");
+    }
+    private static List<StockPriceHistory> supportBreak(int count, int step) {
+        var values = rows(count, step, "77", "78", "81", "85", "86", "84", "81");
+        set(values, 2, "81", "82", "80");
+        set(values, 6, "81", "82", "80");
+        return values;
+    }
+    private static List<StockPriceHistory> falling(int count, int step) {
+        List<StockPriceHistory> out = new ArrayList<>();
+        for (int i = 0; i < count; i++) {
+            BigDecimal close = new BigDecimal("80").add(new BigDecimal(i));
+            out.add(row(DATE.minusDays((long) i * step), close.toPlainString(),
+                    close.add(BigDecimal.ONE).toPlainString(), close.subtract(BigDecimal.ONE).toPlainString()));
+        }
+        return out;
+    }
+    static List<StockPriceHistory> rows(int count, int step, String... prefix) {
+        List<StockPriceHistory> out = new ArrayList<>();
+        for (int i = 0; i < count; i++) out.add(row(DATE.minusDays((long) i * step), "100", "101", "99"));
+        if (count > 40) {
+            set(out, count / 2, "80", "81", "79");
+            set(out, count / 2 + 10, "120", "121", "119");
+        }
+        for (int i = 0; i < prefix.length; i++) {
+            BigDecimal close = new BigDecimal(prefix[i]);
+            set(out, i, prefix[i], close.add(BigDecimal.ONE).toPlainString(), close.subtract(BigDecimal.ONE).toPlainString());
+        }
+        return out;
+    }
+    private static StockPriceHistory row(LocalDate date, String close, String high, String low) {
+        return StockPriceHistory.builder().stockCode("0050").market("台股").tradingDate(date)
+                .openPrice(new BigDecimal(close)).closePrice(new BigDecimal(close))
+                .highPrice(new BigDecimal(high)).lowPrice(new BigDecimal(low)).volume(1_000_000L).build();
+    }
+    private static void set(List<StockPriceHistory> rows, int at, String close, String high, String low) {
+        setValue(rows.get(at), close, high, low);
+    }
+    private static void setValue(StockPriceHistory row, String close, String high, String low) {
+        row.setClosePrice(new BigDecimal(close)); row.setHighPrice(new BigDecimal(high)); row.setLowPrice(new BigDecimal(low));
+    }
+    private static TradingRadarAssetProfileResolver.AssetProfile equityProfile() {
+        return TradingRadarAssetProfileResolver.resolve("0050", "台股", "元大台灣50", null, null,
+                null, null, null, null);
+    }
+    private static TradingRadarEvidenceConfidenceResolver.Evidence completeEvidence() {
+        var groups = new EnumMap<TradingRadarEvidenceConfidenceResolver.Group,
+                TradingRadarEvidenceConfidenceResolver.GroupEvidence>(TradingRadarEvidenceConfidenceResolver.Group.class);
+        for (var group : TradingRadarEvidenceConfidenceResolver.Group.values()) groups.put(group,
+                new TradingRadarEvidenceConfidenceResolver.GroupEvidence(group, List.of(),
+                        1, 1, 1, true, true, true, true, true, true, 1, false, false));
+        var risk = new TradingRadarEvidenceConfidenceResolver.Risk(20, 1, List.of());
+        return new TradingRadarEvidenceConfidenceResolver.Evidence(groups, 100, 100, 100,
+                risk, risk, risk, List.of());
+    }
+}
