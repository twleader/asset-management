+package com.steven.assets.service;
+
+import org.junit.jupiter.api.Test;
+
+import java.math.BigDecimal;
+import java.util.function.Consumer;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class RadarTurningPointBuySafetyTest {
+    private final TradingRadarRuleEngine engine = new TradingRadarRuleEngine();
+
+    @Test void trialDoesNotRequireMa20Ma60OrAnnualRecoveryButStillUsesCompleteInput() {
+        assertThat(engine.turningPointBuyAllowed(input(x -> {}), true)).isTrue();
+        assertThat(engine.turningPointBuyAllowed(input(x -> x.k = null), true)).isFalse();
+        assertThat(engine.turningPointBuyAllowed(null, true)).isFalse();
+    }
+
+    @Test void riskOffExceptionIsOnlyForTrialAndNeverBypassesStaleEquityMarket() {
+        var riskOff = input(x -> x.regime = TradingRadarRuleEngine.MarketRegime.RISK_OFF);
+        assertThat(engine.turningPointBuyAllowed(riskOff, false)).isFalse();
+        assertThat(engine.turningPointBuyAllowed(riskOff, true)).isTrue();
+        var stale = input(x -> {x.regime = TradingRadarRuleEngine.MarketRegime.RISK_OFF; x.stale = true;});
+        assertThat(engine.turningPointBuyAllowed(stale, false)).isFalse();
+        assertThat(engine.turningPointBuyAllowed(stale, true)).isFalse();
+        var bond = input(x -> { x.type = TradingRadarRuleEngine.InstrumentType.BOND;
+            x.regime = TradingRadarRuleEngine.MarketRegime.RISK_OFF; x.stale = true;});
+        assertThat(engine.turningPointBuyAllowed(bond, false)).isTrue();
+        assertThat(engine.turningPointBuyAllowed(bond, true)).isTrue();
+    }
+
+    @Test void fxPremiumChaseAndPositiveBiasBoundariesCannotBeBypassedByTrial() {
+        for (boolean trial : new boolean[]{false, true}) {
+            assertThat(engine.turningPointBuyAllowed(input(x -> x.fx = bd("90")), trial)).isFalse();
+            assertThat(engine.turningPointBuyAllowed(input(x -> x.premium = bd("3")), trial)).isFalse();
+            assertThat(engine.turningPointBuyAllowed(input(x -> x.move = bd("8")), trial)).isFalse();
+            assertThat(engine.turningPointBuyAllowed(input(x -> x.bias = bd("15")), trial)).isFalse();
+            assertThat(engine.turningPointBuyAllowed(input(x -> {x.fx = bd("89.999999999999999999");
+                x.premium = bd("2.999999999999999999"); x.move = bd("7.999999999999999999");
+                x.bias = bd("14.999999999999999999");}), trial)).isTrue();
+        }
+    }
+
+    @Test void fallingMissingOrInvalidMarketDataCannotCreateNewBuys() {
+        for (boolean trial : new boolean[]{false, true}) {
+            assertThat(engine.turningPointBuyAllowed(input(x -> x.move = bd("-0.01")), trial)).isFalse();
+            assertThat(engine.turningPointBuyAllowed(input(x -> x.move = null), trial)).isFalse();
+            assertThat(engine.turningPointBuyAllowed(input(x -> x.price = BigDecimal.ZERO), trial)).isFalse();
+            assertThat(engine.turningPointBuyAllowed(input(x -> x.regime = TradingRadarRuleEngine.MarketRegime.DATA_INCOMPLETE), trial))
+                    .isFalse();
+            assertThat(engine.turningPointBuyAllowed(input(x -> x.move = BigDecimal.ZERO), trial)).isTrue();
+        }
+    }
+
+    @Test void heatUsesExistingBoundariesAndNarrowBandException() {
+        assertThat(engine.turningPointBuyAllowed(input(x -> {x.k=bd("85"); x.d=bd("75");}), true)).isTrue();
+        assertThat(engine.turningPointBuyAllowed(input(x -> {x.k=bd("85.01"); x.d=bd("70");}), true)).isFalse();
+        assertThat(engine.turningPointBuyAllowed(input(x -> {x.k=bd("81"); x.d=bd("80");}), true)).isFalse();
+        assertThat(engine.turningPointBuyAllowed(input(x -> {x.k=bd("100"); x.d=bd("100"); x.band=bd("1.99");}), true))
+                .isTrue();
+        assertThat(engine.turningPointBuyAllowed(input(x -> {x.k=bd("100"); x.d=bd("100"); x.band=bd("2");}), true))
+                .isFalse();
+    }
+
+    @Test void deterioratingFundamentalsBlockBothBuyModes() {
+        for (boolean trial : new boolean[]{false, true}) {
+            var severe = input(x -> x.fundamental = new TradingRadarRuleEngine.FundamentalInput(
+                    true, -.8, -.8, 0.0, 0.0, 0.0, false, false));
+            assertThat(engine.turningPointBuyAllowed(severe, trial)).isFalse();
+            var loss = input(x -> x.fundamental = new TradingRadarRuleEngine.FundamentalInput(
+                    true, -.5, null, null, null, null, true, false));
+            assertThat(engine.turningPointBuyAllowed(loss, trial)).isFalse();
+        }
+    }
+
+    private static TradingRadarRuleEngine.StockInput input(Consumer<Fixture> change) {
+        Fixture x = new Fixture(); change.accept(x);
+        return new TradingRadarRuleEngine.StockInput(true, x.price, BigDecimal.ONE, x.move,
+                new TradingRadarRuleEngine.Indicators(bd("110"), bd("120"), bd("130"), x.k, x.d),
+                bd("40"), bd("45"), TradingRadarRuleEngine.Confirmation.BELOW,
+                TradingRadarRuleEngine.Confirmation.BELOW, TradingRadarRuleEngine.Confirmation.BELOW,
+                x.type, x.regime, x.stale, x.fx, x.bias, null, bd("-5"), bd("10"), x.band,
+                x.premium, null, bd("95"), null, BigDecimal.ONE, x.fundamental, null, null, null);
+    }
+    private static class Fixture {
+        BigDecimal price=bd("100"), move=BigDecimal.ONE, k=bd("40"), d=bd("35"), band=bd("5");
+        BigDecimal fx, premium, bias=bd("-5");
+        boolean stale;
+        TradingRadarRuleEngine.InstrumentType type=TradingRadarRuleEngine.InstrumentType.EQUITY;
+        TradingRadarRuleEngine.MarketRegime regime=TradingRadarRuleEngine.MarketRegime.NEUTRAL;
+        TradingRadarRuleEngine.FundamentalInput fundamental;
+    }
+    private static BigDecimal bd(String value) { return new BigDecimal(value); }
+}
