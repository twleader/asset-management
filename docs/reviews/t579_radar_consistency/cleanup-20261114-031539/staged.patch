+++ b/backend/src/main/java/com/steven/assets/service/RadarTurningPointPolicy.java
@@ -0,0 +1,252 @@
+package com.steven.assets.service;
+
+import com.steven.assets.model.StockPriceHistory;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDate;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+
+import static com.steven.assets.service.TradingRadarRuleEngine.Action;
+
+/**
+ * V23 production action policy, evaluated before every existing evidence/final-action veto.
+ * Scores and the legacy engine's technical disclosures are intentionally unchanged.
+ * All windows and thresholds are judgmental starting values, not calibrated profitability claims.
+ * No clock, IO, mutable entity retention or use of an incomplete/live candle.
+ */
+public final class RadarTurningPointPolicy {
+    private static final BigDecimal HUNDRED = new BigDecimal("100");
+    private static final BigDecimal LOW = new BigDecimal("20");
+    private static final BigDecimal HIGH = new BigDecimal("80");
+    private static final BigDecimal TOUCH = new BigDecimal("1.01");
+    private static final BigDecimal REBOUND = new BigDecimal("1.03");
+    private static final BigDecimal BREAK = new BigDecimal("0.99");
+    private static final Scale SHORT = new Scale("一周／完成日K", 240, 5, 20, 5, 5, 5);
+    private static final Scale SWING = new Scale("1周~1月／完成日K", 240, 10, 60, 5, 10, 20);
+    private static final Scale MEDIUM = new Scale("1月~6月／完成週K", 52, 4, 20, 2, 4, 10);
+    private static final String PREFIX = "V23位置轉折：";
+
+    private RadarTurningPointPolicy() {}
+
+    private record Scale(String label, int position, int recent, int trend, int trendOffset,
+                         int confirmation, int support) {
+        int required() {
+            return Math.max(position, Math.max(trend + trendOffset,
+                    Math.max(confirmation + 1, Math.max(support + 2, Math.max(recent, 4)))));
+        }
+    }
+
+    private record Bar(LocalDate date, BigDecimal close, BigDecimal high, BigDecimal low, Long volume) {}
+    private record Decision(Action action, List<String> reasons, List<String> risks) {}
+    private record Range(BigDecimal min, BigDecimal span) {
+        boolean low(BigDecimal close) {
+            return close.subtract(min).multiply(HUNDRED).compareTo(span.multiply(LOW)) <= 0;
+        }
+        boolean high(BigDecimal close) {
+            return close.subtract(min).multiply(HUNDRED).compareTo(span.multiply(HIGH)) >= 0;
+        }
+        String display(BigDecimal close) {
+            return close.subtract(min).multiply(HUNDRED).divide(span, 2, RoundingMode.HALF_UP).toPlainString();
+        }
+    }
+
+    public static TradingRadarRuleEngine.StockResult apply(
+            TradingRadarRuleEngine.StockResult baseline, RadarInputAssembler.Prepared prepared,
+            boolean held, boolean regularBuySafe, boolean trialBuySafe) {
+        Objects.requireNonNull(baseline, "baseline");
+        Decision shortTerm = decide(baseline.shortAction(), baseline.shortReasons(), baseline.shortRisks(),
+                daily(prepared, SHORT.required()), SHORT, held, regularBuySafe, trialBuySafe);
+        Decision swing = decide(baseline.swingAction(), baseline.swingReasons(), baseline.swingRisks(),
+                daily(prepared, SWING.required()), SWING, held, regularBuySafe, trialBuySafe);
+        Decision medium = decide(baseline.action(), baseline.reasons(), baseline.risks(),
+                weekly(prepared, MEDIUM.required()), MEDIUM, held, regularBuySafe, trialBuySafe);
+        return new TradingRadarRuleEngine.StockResult(
+                baseline.score(), medium.action(), baseline.counterTrend(), medium.reasons(), medium.risks(),
+                baseline.kdHeat(), baseline.timingState(), baseline.kdDeadCross(), baseline.longTermBroken(),
+                baseline.shortScore(), shortTerm.action(), shortTerm.reasons(), shortTerm.risks(),
+                group(medium.action()) != group(shortTerm.action()) || group(medium.action()) != group(swing.action()),
+                baseline.profitTakingConfirmed(), baseline.normalizedBias(), baseline.shortNormalizedBias(),
+                baseline.swingScore(), swing.action(), swing.reasons(), swing.risks());
+    }
+
+    private static Decision decide(Action original, List<String> originalReasons, List<String> originalRisks,
+                                   List<Bar> bars, Scale scale, boolean held,
+                                   boolean regularBuySafe, boolean trialBuySafe) {
+        if (original == Action.NO_TRADE || original == null) {
+            return new Decision(Action.NO_TRADE, copy(originalReasons), copy(originalRisks));
+        }
+        List<String> reasons = new ArrayList<>();
+        List<String> risks = new ArrayList<>();
+        for (String value : copy(originalReasons)) {
+            if (legacyActionText(value)) risks.add("舊基礎引擎狀態（不作V23動作依據）：" + value);
+            else reasons.add(value);
+        }
+        for (String value : copy(originalRisks)) {
+            risks.add(legacyActionText(value) ? "舊基礎引擎提醒（本版動作另判）：" + value : value);
+        }
+        if (!valid(bars, scale.required())) {
+            risks.add(PREFIX + scale.label() + "所需完成K不足或日期／OHLC無效，不產生新交易候選。 ");
+            return finish(cautious(held), reasons, risks);
+        }
+        BigDecimal min = bars.getFirst().close(), max = min;
+        for (int i = 1; i < scale.position(); i++) {
+            min = min.min(bars.get(i).close());
+            max = max.max(bars.get(i).close());
+        }
+        if (min.compareTo(max) == 0) {
+            risks.add(PREFIX + scale.label() + "收盤區間沒有變化，位置無法判定，不產生新交易候選。 ");
+            return finish(cautious(held), reasons, risks);
+        }
+        Range range = new Range(min, max.subtract(min));
+        BigDecimal current = bars.getFirst().close(), prior = bars.get(1).close();
+        BigDecimal currentSum = sum(bars, 0, scale.trend());
+        int priceVsTrend = current.multiply(BigDecimal.valueOf(scale.trend())).compareTo(currentSum);
+        int slope = currentSum.compareTo(sum(bars, scale.trendOffset(), scale.trend()));
+        String trend = priceVsTrend > 0 && slope > 0 ? "向上" : priceVsTrend < 0 && slope < 0 ? "向下" : "盤整";
+        reasons.add(PREFIX + scale.label() + "，近" + scale.position() + "根完成K收盤區間位置 "
+                + range.display(current) + "%、趨勢" + trend + "；位置不是合理價值估計。 ");
+
+        BigDecimal support = establishedBrokenSupport(bars, scale.support());
+        if (support != null) {
+            risks.add(PREFIX + scale.label() + "已反覆測試並反彈的支撐 " + support.toPlainString()
+                    + "，最新兩根完成收盤均跌破支撐下方1%緩衝且續弱；屬確認破位風險退出，即使低檔也不覆蓋此條件。 ");
+            risks.add(PREFIX + "支撐與緩衝為判斷性初值，不保證止損效果，也不預測後續漲跌。 ");
+            return finish(held ? Action.EXIT_CANDIDATE : Action.AVOID, reasons, risks);
+        }
+        boolean recentHigh = false, recentLow = false;
+        for (int i = 0; i < scale.recent(); i++) {
+            recentHigh |= range.high(bars.get(i).close());
+            recentLow |= range.low(bars.get(i).close());
+        }
+        boolean weakened = current.compareTo(prior) < 0
+                && belowAverage(bars, 0, scale.confirmation())
+                && belowAverage(bars, 1, scale.confirmation())
+                && bars.getFirst().high().compareTo(bars.get(1).high()) < 0;
+        if (recentHigh && !range.low(current) && weakened) {
+            reasons.add(PREFIX + scale.label() + "近期曾處高檔，兩根完成收盤各自跌破確認均線，且高點與收盤降低，形成高檔轉弱候選。 ");
+            risks.add(PREFIX + "高檔轉弱條件為判斷性初值，不代表已獲利或預測後續下跌。 ");
+            return finish(held ? Action.REDUCE_CANDIDATE : Action.AVOID, reasons, risks);
+        }
+        boolean stabilized = bars.getFirst().low().compareTo(bars.get(1).low()) > 0
+                && bars.get(1).low().compareTo(bars.get(2).low()) >= 0
+                && current.compareTo(prior.max(bars.get(2).close()).max(bars.get(3).close())) > 0
+                && !belowOrAtAverage(bars, 0, scale.confirmation());
+        if (recentLow && !range.high(current) && stabilized) {
+            if (trialBuySafe) {
+                reasons.add(PREFIX + scale.label() + "近期曾處低檔，低點抬高且完成收盤突破前三根收盤與確認均線，可評估分批試單。 ");
+                risks.add(PREFIX + "僅限小額分批試單；RISK_OFF僅允許此試單例外，下降趨勢仍可能延續，不保證反彈。 ");
+                return finish(Action.TRIAL_BUY, reasons, risks);
+            }
+            risks.add(PREFIX + scale.label() + "雖有低檔止穩形狀，買方安全條件尚未通過，維持風險觀察。 ");
+        }
+        if (range.low(current)) {
+            risks.add(PREFIX + scale.label() + "目前位於低檔但未通過止穩試單確認，只列風險觀察；不因低分直接減碼，也不因跌深直接買進。 ");
+            return finish(cautious(held), reasons, risks);
+        }
+        if (original == Action.BUY_CANDIDATE || original == Action.ADD_CANDIDATE) {
+            if (regularBuySafe && !"向下".equals(trend) && !range.high(current))
+                return finish(original, reasons, risks);
+            risks.add(PREFIX + scale.label() + "原買方候選未通過安全／趨勢／位置條件，暫緩買進。 ");
+            return finish(cautious(held), reasons, risks);
+        }
+        if (original == Action.TRIAL_BUY || sell(original)) {
+            risks.add(PREFIX + scale.label() + "原分數引擎候選未獲本軌位置轉折確認，改為風險觀察。 ");
+            return finish(cautious(held), reasons, risks);
+        }
+        return finish(original, reasons, risks);
+    }
+
+    private static BigDecimal establishedBrokenSupport(List<Bar> bars, int lookback) {
+        BigDecimal support = bars.get(2).low();
+        for (int i = 3; i < lookback + 2; i++) support = support.min(bars.get(i).low());
+        BigDecimal breakPrice = support.multiply(BREAK);
+        if (bars.getFirst().close().compareTo(breakPrice) >= 0
+                || bars.get(1).close().compareTo(breakPrice) >= 0
+                || bars.getFirst().close().compareTo(bars.get(1).close()) >= 0) return null;
+        for (int recent = 2; recent < lookback + 2; recent++) {
+            if (bars.get(recent).low().compareTo(support.multiply(TOUCH)) > 0) continue;
+            for (int older = recent + 3; older < lookback + 2; older++) {
+                if (bars.get(older).low().compareTo(support.multiply(TOUCH)) > 0) continue;
+                for (int between = recent + 1; between < older; between++) {
+                    if (bars.get(between).close().compareTo(support.multiply(REBOUND)) >= 0) return support;
+                }
+            }
+        }
+        return null;
+    }
+
+    private static List<Bar> daily(RadarInputAssembler.Prepared prepared, int required) {
+        if (prepared == null || prepared.dailyContractRowsDesc() == null
+                || prepared.firstCompletedIndex() < 0 || prepared.firstCompletedIndex() > 1) return List.of();
+        int start = prepared.firstCompletedIndex();
+        if (prepared.dailyContractRowsDesc().size() - start < required) return List.of();
+        List<Bar> out = new ArrayList<>(required);
+        for (int i = start; i < start + required; i++) {
+            StockPriceHistory row = prepared.dailyContractRowsDesc().get(i);
+            out.add(row == null ? new Bar(null, null, null, null, null)
+                    : new Bar(row.getTradingDate(), row.getClosePrice(), row.getHighPrice(), row.getLowPrice(), row.getVolume()));
+        }
+        return List.copyOf(out);
+    }
+
+    private static List<Bar> weekly(RadarInputAssembler.Prepared prepared, int required) {
+        if (prepared == null || prepared.weeklyBarsDesc() == null || prepared.weeklyBarsDesc().size() < required)
+            return List.of();
+        List<Bar> out = new ArrayList<>(required);
+        for (int i = 0; i < required; i++) {
+            WeeklyBarAggregator.WeeklyBar row = prepared.weeklyBarsDesc().get(i);
+            out.add(row == null ? new Bar(null, null, null, null, null)
+                    : new Bar(row.weekEndDate(), row.close(), row.high(), row.low(), row.volume()));
+        }
+        return List.copyOf(out);
+    }
+
+    private static boolean valid(List<Bar> bars, int required) {
+        if (bars.size() < required) return false;
+        LocalDate previous = null;
+        for (Bar bar : bars) {
+            if (bar.date() == null || previous != null && !bar.date().isBefore(previous)
+                    || !positive(bar.close()) || !positive(bar.high()) || !positive(bar.low())
+                    || bar.low().compareTo(bar.close()) > 0 || bar.high().compareTo(bar.close()) < 0) return false;
+            previous = bar.date();
+        }
+        return true;
+    }
+    private static boolean positive(BigDecimal value) { return value != null && value.signum() > 0; }
+    private static BigDecimal sum(List<Bar> bars, int start, int count) {
+        BigDecimal total = BigDecimal.ZERO;
+        for (int i = start; i < start + count; i++) total = total.add(bars.get(i).close());
+        return total;
+    }
+    private static boolean belowAverage(List<Bar> bars, int start, int count) {
+        return bars.get(start).close().multiply(BigDecimal.valueOf(count)).compareTo(sum(bars, start, count)) < 0;
+    }
+    private static boolean belowOrAtAverage(List<Bar> bars, int start, int count) {
+        return bars.get(start).close().multiply(BigDecimal.valueOf(count)).compareTo(sum(bars, start, count)) <= 0;
+    }
+    private static Action cautious(boolean held) { return held ? Action.HOLD_CAUTION : Action.WAIT; }
+    private static boolean sell(Action action) {
+        return action == Action.REDUCE_CANDIDATE || action == Action.EXIT_CANDIDATE || action == Action.AVOID;
+    }
+    private static int group(Action action) {
+        if (action == null || action == Action.NO_TRADE) return 4;
+        return switch (action) {
+            case BUY_CANDIDATE, ADD_CANDIDATE, TRIAL_BUY -> 1;
+            case HOLD, WATCH, HOLD_CAUTION, WAIT -> 2;
+            case REDUCE_CANDIDATE, EXIT_CANDIDATE, AVOID -> 3;
+            case NO_TRADE -> 4;
+        };
+    }
+    private static List<String> copy(List<String> values) { return values == null ? List.of() : List.copyOf(values); }
+    private static Decision finish(Action action, List<String> reasons, List<String> risks) {
+        return new Decision(action, List.copyOf(reasons), List.copyOf(risks));
+    }
+    private static boolean legacyActionText(String value) {
+        return value.contains("獲利了結獲得確認") || value.contains("此位置不建議追殺出場")
+                || value.contains("V11 的極端超賣保護") || value.startsWith("逆勢試單的本質")
+                || value.contains("本訊號只限小額試單");
+    }
+}
