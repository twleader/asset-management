POSTGRES_DB=assets
POSTGRES_USER=assets
POSTGRES_PASSWORD=請填入密碼

# 警示觸發 Email 通知（Requirement 23）
# Gmail App Password 取得步驟：
#   1. Google 帳號 → 安全性 → 開啟「兩步驟驗證」（必要前置）
#   2. Google 帳號 → 安全性 → 應用程式密碼 → 建立新密碼（自訂名稱如 asset-management）
#   3. 將產生的 16 碼密碼（不含空白）填入 MAIL_PASSWORD
# 未填時 EmailService 自動 disabled，警示觸發不會寄信但不報錯
MAIL_USERNAME=
MAIL_PASSWORD=
# 寄件人 email；留空則 = MAIL_USERNAME
NOTIFICATION_FROM=
