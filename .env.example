POSTGRES_DB=assets
POSTGRES_USER=assets
POSTGRES_PASSWORD=請填入密碼

# Docker 外部唯讀 API port 固定為 127.0.0.1:9090，不由 .env 改寫；維持純 http（內部
# upstream），對外 HTTPS 由 Tailscale Serve 包一層（見 scripts/configure-tailscale-api-gateway.sh），
# 與下面前端網站的 HTTPS 是兩套獨立機制，互不影響。
# BFF 8080 與 external-materials 8082 不發布到 host；遠端請使用 path-scoped Tailscale Serve。

# 前端網站 HTTPS 自簽憑證目錄（選用）。留空則用預設 ./secrets/frontend-tls；
# 容器啟動時若目錄內沒有 fullchain.pem/privkey.pem 會自動產生 localhost-only 預設憑證。
# 要用於對外公網 IP／網域，請執行 scripts/generate-self-signed-frontend-cert.sh <IP或網域>，
# 詳見 secrets/frontend-tls/README.md。
FRONTEND_TLS_SECRETS_DIR_HOST=./secrets/frontend-tls

# 警示觸發 Email 通知（Requirement 23）
# Gmail App Password 取得步驟：
#   1. Google 帳號 → 安全性 → 開啟「兩步驟驗證」（必要前置）
#   2. Google 帳號 → 安全性 → 應用程式密碼 → 建立新密碼（自訂名稱如 asset-management）
#   3. 將產生的 16 碼密碼（不含空白）填入 MAIL_PASSWORD
# 未填時 EmailService 自動 disabled，警示觸發不會寄信但不報錯
MAIL_USERNAME=
MAIL_PASSWORD=
# 寄件人 email；留空則 = MAIL_USERNAME
NOTIFICATION_FROM=

# Gmail OAuth2 登入（Requirement 28）
# Google Cloud Console → API 與服務 → 憑證 → 建立 OAuth 用戶端 ID（類型：Web 應用程式）
# 已授權的重新導向 URI 需登記：
#   Docker 本機: http://localhost/login/oauth2/code/google
#   Vite 開發:   http://localhost:5173/login/oauth2/code/google
#   正式 HTTPS:  https://你的網域/login/oauth2/code/google
# 注意：Google 的 redirect URI 驗證規則裡，host 不可為裸 IP（localhost 例外）；用固定公網 IP
# （而非網域）對外提供本網站時，該 IP 位址的 redirect URI 可能無法通過 Google Cloud Console
# 的驗證。此限制只影響「透過該公網 IP 用 Google 帳號登入」，不影響其他純瀏覽／唯讀功能；
# 實際是否接受請自行在 Google Cloud Console 新增該 redirect URI 測試為準。
# 主要管理者的 Google 帳號（必填）：首次登入即為 ADMIN/ACTIVE，且不可被停用或降級。
# 請填完整 email，不要加引號；例如 owner@example.com。
ADMIN_EMAIL=請填入主要管理者的Google帳號
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 交易雷達「發布到 Blog」（Requirement 102）：本 App 對外可從瀏覽器存取的網域，供 Blogger OAuth
# callback 組 redirect_uri，必須是 https:// 開頭（Google 對非 localhost 的 redirect_uri 要求
# HTTPS）；只需在執行〔連接 Blogger 帳號〕當下能連得到，不需永久公開，例如 Tailscale 為本機
# 自動核發的 https://<裝置>.<tailnet>.ts.net。
APP_PUBLIC_BASE_URL=

# 選用的富邦唯讀庫存同步；秘密值只放在下列 host 目錄內，不放進 .env。
FUBON_ENABLED=true
FUBON_TW_LIVE_QUOTES_ENABLED=true
# 台股大盤 SSE（Requirement 116）：預設關閉。symbol 必須先以富邦
# intraday/tickers?type=INDEX&exchange=TWSE 的回應確認，不可直接採文件範例。
FUBON_TAIEX_INDEX_STREAM_ENABLED=false
FUBON_TAIEX_INDEX_SYMBOL=
FUBON_INVENTORY_SYNC_ENABLED=false
FUBON_TRADE_SYNC_ENABLED=false
FUBON_ETF_HOLDINGS_SYNC_ENABLED=false
FUBON_BANK_BALANCE_SYNC_ENABLED=false
FUBON_SETTLEMENT_SYNC_ENABLED=false
FUBON_REALIZED_GAIN_SYNC_ENABLED=false
# 雷達範圍的市場資料整合，預設均停用；不代表券商憑證已有可驗證唯讀權限。
FUBON_DIVIDEND_SYNC_ENABLED=false
FUBON_TECHNICAL_INDICATOR_SYNC_ENABLED=false
FUBON_STOCK_PUSH_ENABLED=false
FUBON_SECRETS_DIR_HOST=./secrets/fubon

# 選用的元大證券唯讀查詢（SPARK API）；秘密值只放在下列 host 目錄內，不放進 .env。
YUANTA_ENABLED=false
YUANTA_SECRETS_DIR_HOST=./secrets/yuanta

# 今日股市分析（Requirement 31）：每個台股交易日 07:30 由 Claude Opus 4.8 判斷當日走向
# 金鑰取得：https://console.anthropic.com → Settings → API Keys → Create Key（sk-ant-...）
# 未填時分析頁顯示「尚未設定 Anthropic API 金鑰」（status=NOT_CONFIGURED），排程安全跳過不報錯
ANTHROPIC_API_KEY=
# 可選：覆蓋分析模型（預設 claude-opus-4-8）
ANTHROPIC_MODEL=claude-opus-4-8

# 歷年資產每日排程自動匯出（Requirement 34 / Task 171）
# 排程產出的 .xlsx 落地的「主機家目錄根」，會掛入 business-services 容器的 /home/steven。
# 使用者於歷年資產頁用檔案總管式選擇器挑選的相對子資料夾落於此目錄下。
# ${HOME} 會由 Docker Compose 展開成目前使用者的家目錄；也可改填其他可寫的絕對路徑。
# macOS 範例 /Users/alice；Linux / WSL 範例 /home/alice。
EXPORT_OUTPUT_DIR_HOST=${HOME}

# 匯出檔案同步 Google Drive（Requirement 50 / Task 241；Requirement 51 推廣至其餘八頁）
# —— 選用功能，不設也不影響任何既有功能。
#
# 本機輸出「一律照寫」，Drive 只是額外多上傳一份副本；預設關閉（DB 的 gdrive_enabled=false），
# 要啟用是在各匯出頁上開開關並挑 Drive 資料夾。
#
# 使用前必須先自行建立 rclone remote：
#   rclone config create GDriveOutput drive scope=drive
#
# 建立在既有的 ~/.config/rclone/rclone.conf 即可（與 DB 備份的 [GoogleDriver]／[gdrive-crypt]
# 共存於同一份檔案）。docker-compose 會把這一份唯讀掛入 business-services 與
# external-materials-service 兩個容器。
#
# 已知取捨：該檔同時含 DB 備份 remote 的 OAuth refresh token 與 crypt 解密密碼，故掛入的服務
# （含對外抓第三方資料的 external-materials-service）都讀得到它們。原設計為分離兩份設定檔以避免
# 此擴權，改為共用是權衡維護成本後的決定；取捨全文與「若要復原隔離」的步驟見
# spec/steering/tech.md §4。
#
# 需要 scope=drive（完整存取）而非 drive.file 的原因：drive.file 下 rclone 只看得到自己建立的檔案，
# 連使用者手動建立的目標資料夾都列不出來，無法寫進去。
GDRIVE_OUTPUT_REMOTE=GDriveOutput
