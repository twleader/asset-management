POSTGRES_DB=assets
POSTGRES_USER=assets
POSTGRES_PASSWORD=assets1234

# 警示觸發 email 通知（Requirement 23）
# MAIL_USERNAME = 寄件 Gmail 帳號（完整含 @gmail.com）
# MAIL_PASSWORD = Gmail 16 碼「應用程式密碼」(App Password)，非登入密碼；需先開啟兩步驟驗證後產生
# NOTIFICATION_FROM = 顯示寄件人，可留空（留空時用 MAIL_USERNAME）
# 三者填好後執行：docker compose up -d business-services（env 變更須 recreate，restart 不夠）
MAIL_USERNAME=
MAIL_PASSWORD=
NOTIFICATION_FROM=
