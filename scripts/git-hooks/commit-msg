#!/usr/bin/env bash
#
# SDD commit-msg hook — 強制 spec 與 code 同步
#
# 規則：當 staged 變更觸及「會改變功能或契約」的檔案時，
#       同一 commit 必須也包含 spec/ 下的修改。
#
# 為什麼是 commit-msg 而不是 pre-commit：
#   pre-commit 階段 COMMIT_EDITMSG 尚未寫入本次訊息，`git commit -m "[skip-spec] ..."`
#   的訊息在那個時點讀不到 —— 舊版因此有兩個 bug：
#     (a) fail-closed：加了 [skip-spec] 仍被擋；
#     (b) 更糟的 fail-open：下一次 commit 會讀到上一次殘留的 COMMIT_EDITMSG，
#         若那次含 [skip-spec]，這次就被靜默放行。
#   commit-msg 以訊息檔路徑作為 $1，判斷才是可靠的；staged 檔案在此階段仍查得到。
#
# 觸發路徑：
#   - backend/src/main/java/**/controller/*.java   （API 端點）
#   - backend/src/main/java/**/model/*.java        （Entity / 欄位）
#   - backend/src/main/java/**/dto/*.java          （API 契約）
#   - frontend/src/views/*.vue                     （頁面）
#   - frontend/src/router/**                       （路由）
#   - backend/src/main/resources/db/changelog/**   （Schema）
#   - bff/src/main/java/**                         （BFF 路由 / 聚合）
#
# 例外（不阻擋）：
#   - commit 訊息含 [skip-spec]
#   - git commit --no-verify
#
# 安裝：
#   git config core.hooksPath scripts/git-hooks
#

set -euo pipefail

msg_file="${1:?commit-msg hook 需要訊息檔路徑}"

# [skip-spec] 逃生門 —— 讀本次真正的訊息，不是殘留檔
if grep -qF '[skip-spec]' "$msg_file"; then
  exit 0
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

trigger=$(echo "$staged" | grep -E \
  -e '^backend/src/main/java/.*/controller/.*\.java$' \
  -e '^backend/src/main/java/.*/model/.*\.java$' \
  -e '^backend/src/main/java/.*/dto/.*\.java$' \
  -e '^frontend/src/views/.*\.vue$' \
  -e '^frontend/src/router/' \
  -e '^backend/src/main/resources/db/changelog/' \
  -e '^bff/src/main/java/' \
  || true)

[ -z "$trigger" ] && exit 0

spec_changed=$(echo "$staged" | grep -E '^spec/' || true)
[ -n "$spec_changed" ] && exit 0

# === 阻擋並說明 ===
cat >&2 <<EOF
✗ SDD 檢查未通過：偵測到功能性變更，但 spec/ 未同步更新

下列 staged 檔案屬於「會改變功能或契約」的範圍：
$(echo "$trigger" | sed 's/^/    /')

依 CLAUDE.md 規範，新增 Entity / API endpoint / 頁面 / 業務邏輯
必須先更新 spec：
    1. spec/requirements.md     → User Story + Acceptance Criteria
    2. spec/design.md           → 架構 / 資料模型 / API
    3. spec/tasks/tNNN_*.md     → 自足任務檔（規範見 spec/tasks/README.md）
    4. /spec-review             → 對抗式審查，quality_score < 8 不得實作

注意：本 hook 只驗「spec/ 有沒有被碰」，不看內容。
內容正確性請跑 bash scripts/spec-check.sh 與 /spec-review。

如何處理：
    A. 補上 spec/ 變更 → git add spec/... → 重新 commit
    B. 若這次確實只是 bug fix / 樣式調整：
       git commit -m '[skip-spec] 你的訊息'
    C. 緊急情況：git commit --no-verify（請審慎使用）

EOF

exit 1
